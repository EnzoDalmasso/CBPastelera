# URL pública definitiva del sitio (canonical, Open Graph y sitemap).
# En Vercel, si no se define, se usa automáticamente el dominio de producción del proyecto.
NEXT_PUBLIC_SITE_URL=https://www.ejemplo.com

# Supabase → Project Settings → API (o Data API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "anon public" o la nueva "publishable key" (sb_publishable_...). Nunca la service_role/secret.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
